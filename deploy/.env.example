POSTGRES_DB=loka_prod
POSTGRES_USER=loka
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# Also the domain Caddy serves and gets a certificate for.
PHX_HOST=test.keraloka.ch

# `mix phx.gen.secret`
SECRET_KEY_BASE=CHANGE_ME_run_mix_phx.gen.secret
TOKEN_SIGNING_SECRET=CHANGE_ME_run_mix_phx.gen.secret

POOL_SIZE=10
PORT=4000

EMAIL_FROM=noreply@keraloka.ch
MAILPIT_UI_AUTH=admin:CHANGE_ME

# Where the loka Caddy listens on the host.
# Behind a server proxy: a free localhost port, point the proxy at it.
HTTP_PUBLISH=127.0.0.1:<port>
# Standalone with HTTPS instead: Caddy gets the certificate itself.
# SITE_ADDRESS=test.keraloka.ch
# HTTP_PUBLISH=80
# HTTPS_PUBLISH=443

THUNDERFOREST_API_KEY=

